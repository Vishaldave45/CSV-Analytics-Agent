# Application Settings
DEFAULT_ENCODING=utf-8
MAX_CSV_SIZE_MB=500

# LLM API Configuration
# Get your FREE key at: https://aistudio.google.com/app/apikey  (must start with AIzaSy...)
GOOGLE_API_KEY=your_google_ai_studio_key_here


# LangSmith Observability & Tracing Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=csv-analytics-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_SESSION=development
LANGCHAIN_TAGS=local,csv-agent